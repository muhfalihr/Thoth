#!/bin/sh
set -eu

profile_dir=/var/lib/thoth/browser-profile
runtime=/opt/thoth/scout/runtime/legacy_cdp.ts

usage() {
    echo "usage: start-legacy-cdp [--check|--offline-smoke]" >&2
    exit 64
}

check_only=false
offline_smoke=false

case "$#" in
    0)
        ;;
    1)
        case "$1" in
            --check)
                check_only=true
                ;;
            --offline-smoke)
                offline_smoke=true
                ;;
            *)
                usage
                ;;
        esac
        ;;
    *)
        usage
        ;;
esac

chromium_path=
chromium_count=0
for candidate in /ms-playwright/chromium-[0-9]*/chrome-linux*/chrome; do
    [ -x "$candidate" ] || continue
    chromium_path=$candidate
    chromium_count=$((chromium_count + 1))
done

if [ "$chromium_count" -ne 1 ]; then
    echo "legacy CDP requires exactly one Chromium executable; found $chromium_count" >&2
    exit 1
fi

if [ ! -d "$profile_dir" ] || [ ! -w "$profile_dir" ]; then
    echo "legacy CDP profile directory is unavailable" >&2
    exit 1
fi

if [ ! -r "$runtime" ]; then
    echo "legacy CDP supervisor is unavailable" >&2
    exit 1
fi

if [ "$check_only" = true ]; then
    exit 0
fi

# Chromium binds DevTools to loopback whatever address it is given, so the browser
# stays private and the supervisor publishes the relay on the container network.
if [ "$offline_smoke" = true ]; then
    exec bun "$runtime" \
        --chromium "$chromium_path" --profile "$profile_dir" --offline-smoke
fi

exec bun "$runtime" \
    --chromium "$chromium_path" --profile "$profile_dir"
