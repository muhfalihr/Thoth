#!/bin/sh
set -eu

profile_dir=/var/lib/thoth/browser-profile

case "$#" in
    0)
        check_only=false
        ;;
    1)
        if [ "$1" != "--check" ]; then
            echo "usage: start-legacy-cdp [--check]" >&2
            exit 64
        fi
        check_only=true
        ;;
    *)
        echo "usage: start-legacy-cdp [--check]" >&2
        exit 64
        ;;
esac

chromium_path=
chromium_count=0
for candidate in /ms-playwright/chromium-[0-9]*/chrome-linux*/chrome; do
    [ -x "$candidate" ] || continue
    chromium_path=$candidate
    chromium_count=$((chromium_count + 1))
done

if [ "$chromium_count" -ne 1 ]; then
    echo "legacy CDP requires exactly one Chromium executable; found $chromium_count" >&2
    exit 1
fi

if [ ! -d "$profile_dir" ] || [ ! -w "$profile_dir" ]; then
    echo "legacy CDP profile directory is unavailable" >&2
    exit 1
fi

if [ "$check_only" = true ]; then
    exit 0
fi

exec "$chromium_path" \
    --headless=new \
    --remote-debugging-address=0.0.0.0 \
    --remote-debugging-port=18800 \
    --user-data-dir="$profile_dir" \
    --no-first-run \
    --no-default-browser-check \
    --disable-dev-shm-usage \
    https://www.tiktok.com/
