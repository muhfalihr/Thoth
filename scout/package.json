{
  "name": "scout",
  "private": true,
  "version": "1.0.0",
  "description": "Upstream content-sourcing untuk Thoth — TypeScript, dijalankan native via Bun (tanpa build step).",
  "type": "module",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
