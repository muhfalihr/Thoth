        "properties": {
          "from_stage": {
            "anyOf": [
              {
                "enum": [
                  "validation",
                  "source",
                  "assets",
                  "narration",
                  "render",
                  "review",
                  "delivery"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "From Stage"
          }
        },
        "title": "RetryRequest",
        "type": "object"
      },
      "ReviewRequest": {
        "additionalProperties": false,
        "properties": {
          "require_publish_approval": {
            "title": "Require Publish Approval",
            "type": "boolean"
          }
        },
        "required": [
          "require_publish_approval"
        ],
        "title": "ReviewRequest",
        "type": "object"
      },
      "SourceInput": {
        "additionalProperties": false,
