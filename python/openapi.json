        "title": "StageSummary",
        "type": "object"
      },
      "StyleChoice": {
        "additionalProperties": false,
        "properties": {
          "preset_id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$",
            "title": "Preset Id",
            "type": "string"
          }
        },
        "required": [
          "preset_id"
        ],
        "title": "StyleChoice",
        "type": "object"
      },
      "StylePreset": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
