        "title": "StageProgress",
        "type": "object"
      },
      "StageSummary": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^(validation|source|assets|narration|render|review|delivery)$",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "progress": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Progress"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "completed",
              "waiting",
              "failed",
              "cancelled"
