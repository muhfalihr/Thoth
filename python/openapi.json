        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OutputRequest": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
