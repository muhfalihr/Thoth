{
  "components": {
    "schemas": {
      "ApprovalRequest": {
        "additionalProperties": false,
        "properties": {
          "allowed_decisions": {
            "items": {
              "enum": [
                "approve",
                "reject"
              ],
              "type": "string"
            },
            "title": "Allowed Decisions",
            "type": "array"
          },
          "approval_id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$",
            "title": "Approval Id",
            "type": "string"
          },
          "kind": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Kind",
            "type": "string"
          },
          "prompt": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          }
        },
        "required": [
          "approval_id",
          "kind",
          "prompt",
          "allowed_decisions"
        ],
        "title": "ApprovalRequest",
        "type": "object"
      },
      "ApprovalSubmission": {
        "additionalProperties": false,
        "description": "An approval decision supplied by a caller, before actor audit data is added.",
        "properties": {
          "approval_id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$",
            "title": "Approval Id",
            "type": "string"
          },
          "decision": {
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "approval_id",
          "decision"
        ],
        "title": "ApprovalSubmission",
        "type": "object"
      },
      "ArtifactRef": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$",
            "title": "Artifact Id",
            "type": "string"
          },
          "checksum": {
            "anyOf": [
              {
                "pattern": "^sha256:[0-9a-fA-F]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checksum"
          },
          "kind": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "location": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Location",
            "type": "string"
          },
          "media_type": {
            "pattern": "^[a-z][a-z0-9.+-]*/[a-z][a-z0-9.+-]*$",
            "title": "Media Type",
            "type": "string"
          },
          "size_bytes": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Bytes"
          }
        },
        "required": [
          "artifact_id",
          "kind",
          "label",
          "media_type",
          "location"
        ],
        "title": "ArtifactRef",
        "type": "object"
      },
      "EventKind": {
        "enum": [
          "workflow.queued",
          "workflow.started",
          "workflow.completed",
          "workflow.failed",
          "workflow.cancelled",
          "stage.started",
          "stage.progress",
          "stage.completed",
          "approval.required",
          "approval.recorded",
          "artifact.created",
          "diagnostic.recorded"
