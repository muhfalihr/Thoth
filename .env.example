# THOTH — Environment Variables Template
# Copy ke .env dan isi nilai yang sesuai.
# JANGAN commit .env ke git — sudah ada di .gitignore
#
# Prefix kanonik = THOTH_. Prefix lama CLIPPER_* masih didukung (di-mirror ke THOTH_* saat start).
# Model per-stage & cara ganti: lihat docs/MODELS.md. Semua opsi config: config.toml.example.

# ─── LLM Providers ───────────────────────────────────────────────────────────
THOTH_GROQ_API_KEY=your_groq_key_here
THOTH_OPENAI_API_KEY=your_openai_key_here
THOTH_CLAUDE_API_KEY=your_anthropic_key_here
THOTH_GEMINI_API_KEY=your_gemini_key_here
THOTH_NOVITA_API_KEY=your_novita_key_here
# OpenRouter — opsional, untuk [cover] image_engine="openrouter" (default model: google/gemini-2.5-flash-image)
THOTH_OPENROUTER_API_KEY=
THOTH_TOGETHER_API_KEY=
THOTH_FIREWORKS_API_KEY=
THOTH_VLLM_API_KEY=

# ─── Vector DB / RAG ─────────────────────────────────────────────────────────
THOTH_SUPABASE_URL=postgresql://user:pass@host:5432/db
THOTH_EMBED_API_KEY=

# ─── News Enrichment ─────────────────────────────────────────────────────────
THOTH_SERPER_API_KEY=

# ─── TTS Providers ───────────────────────────────────────────────────────────
# MiniMax Speech 2.8 HD Sync
THOTH_MINIMAX_API_KEY=your_minimax_api_key
THOTH_MINIMAX_GROUP_ID=your_minimax_group_id

# Fish Audio S2 Pro
THOTH_FISH_AUDIO_API_KEY=your_fish_audio_key

# ElevenLabs
THOTH_ELEVENLABS_API_KEY=

# ─── Avatar ───────────────────────────────────────────────────────────────────
THOTH_DID_API_KEY=
THOTH_HEYGEN_API_KEY=

# ─── Tooling / override (opsional) ────────────────────────────────────────────
FFMPEG_PATH=                 # path ffmpeg.exe (kosong = auto-download / ffmpeg.exe lokal)
THOTH_PYTHON=                # interpreter Python untuk renderer cover/headline (kosong = "python")
THOTH_WHISPER_LANGUAGE=      # paksa bahasa transcribe, mis. "id" (kosong = auto-detect)

# ─── Knob model OpenClaw (opsional — default sudah bagus, lihat docs/MODELS.md) ─
# Catatan: OpenClaw membaca .novita_key (FILE di ~/.openclaw/workspace), bukan key di atas.
THOTH_LLM_MODEL=             # task teks OpenClaw (footage_objects/extract_figures/resolve_source)
THOTH_CONTEXT_MODEL=         # enrich_context / pulse_harvest (default deepseek-v3.1)
THOTH_VISION_MODEL=          # vision crop/discovery (default qwen3-vl-8b)
THOTH_EMBED_MODEL=           # embedding CKB/RAG (default qwen3-embedding-8b)
THOTH_GROUND=                # "0" = matikan web-grounding status entitas (enrich_context)
# CKB (Cultural Knowledge Base) Supabase: pakai THOTH_SUPABASE_URL di atas + `npm install pg` di
# workspace + file .supabase_url. Tanpa itu → CKB degrade ke cache lokal JSON. Lihat openclaw/README.md.
