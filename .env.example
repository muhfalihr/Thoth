# THOTH — Environment Variables Template
# Copy ke .env dan isi nilai yang sesuai.
# JANGAN commit .env ke git — sudah ada di .gitignore
#
# Prefix kanonik = THOTH_.
# Model per-stage & cara ganti: lihat docs/MODELS.md. Semua opsi config: config.toml.example.

# ─── LLM Providers ───────────────────────────────────────────────────────────
THOTH_GROQ_API_KEY=your_groq_key_here
THOTH_OPENAI_API_KEY=your_openai_key_here
THOTH_CLAUDE_API_KEY=your_anthropic_key_here
THOTH_GEMINI_API_KEY=your_gemini_key_here
THOTH_NOVITA_API_KEY=your_novita_key_here
# OpenRouter — opsional, untuk [cover] image_engine="openrouter" (default model: google/gemini-2.5-flash-image)
THOTH_OPENROUTER_API_KEY=
THOTH_TOGETHER_API_KEY=
THOTH_FIREWORKS_API_KEY=
THOTH_VLLM_API_KEY=

# ─── Provider base URL (opsional — kosong = pakai default resmi provider) ────
# Satu-satunya tempat host provider boleh ditulis. Rust (crates/thoth-core/src/endpoints.rs),
# scout (scout/lib/env.ts), dan skrip Python (scripts/lib/endpoints.py) SEMUA membaca variabel
# yang sama — jadi mengarahkan Thoth ke gateway/proxy/endpoint pengganti = satu edit di sini,
# bukan berburu literal di tiga bahasa. Trailing slash aman (di-strip), nilai kosong = default.
THOTH_GROQ_BASE_URL=          # default https://api.groq.com/openai/v1
THOTH_OPENAI_BASE_URL=        # default https://api.openai.com/v1
THOTH_CLAUDE_BASE_URL=        # default https://api.anthropic.com/v1
THOTH_GEMINI_BASE_URL=        # default https://generativelanguage.googleapis.com/v1beta
THOTH_NOVITA_BASE_URL=        # default https://api.novita.ai/openai  (OpenAI-compatible)
THOTH_NOVITA_API_BASE_URL=    # default https://api.novita.ai        (API Novita sendiri: flux, merge-face)
THOTH_OPENROUTER_BASE_URL=    # default https://openrouter.ai/api
THOTH_TOGETHER_BASE_URL=      # default https://api.together.xyz
THOTH_FIREWORKS_BASE_URL=     # default https://api.fireworks.ai/inference
THOTH_ELEVENLABS_BASE_URL=    # default https://api.elevenlabs.io/v1
THOTH_VLLM_BASE_URL=          # default http://localhost:8000     (server vLLM sendiri)
THOTH_OLLAMA_BASE_URL=        # default http://localhost:11434    (ollama lokal, tanpa API key)
# Catatan: llm.novita_base_url / vision.* di config.toml tetap menang kalau diisi — variabel di
# atas hanya menyetel DEFAULT-nya, jadi literal host cuma hidup di satu tempat per bahasa.

# ─── Pilihan provider untuk scout ────────────────────────────────────────────
# scout memakai provider yang sama dengan crates Rust: groq | openai | claude | gemini | novita |
# openrouter | together | fireworks | vllm | ollama. Kosong = novita (perilaku lama).
# Var per-peran menang atas var global; nama yang salah ketik langsung error (bukan diam-diam
# jatuh ke default) supaya tagihan tak jalan ke provider yang tak dimaksud.
THOTH_SCOUT_PROVIDER=         # default novita — dipakai semua peran di bawah kalau tak dioverride
THOTH_SCOUT_CHAT_PROVIDER=    # LLM teks: dossier, trace_source, planner main-footage
THOTH_SCOUT_VISION_PROVIDER=  # vision: crop komentar/profil, OCR subtitle, deskripsi scene
THOTH_SCOUT_EMBED_PROVIDER=   # embedding: rankBySimilarity di lib/embed.ts
# Ganti provider = ganti MODEL juga. Default model masih ID Novita, jadi setel juga yang relevan:
# THOTH_LLM_MODEL, THOTH_VISION_MODEL, THOTH_CONTEXT_MODEL, THOTH_EMBED_MODEL,
# THOTH_PLANNER_MODEL, THOTH_SUBTITLE_OCR_MODEL.

# ─── Vector DB / RAG ─────────────────────────────────────────────────────────
THOTH_SUPABASE_URL=postgresql://user:pass@host:5432/db
THOTH_EMBED_API_KEY=

# ─── News Enrichment ─────────────────────────────────────────────────────────
THOTH_SERPER_API_KEY=

# ─── TTS Providers ───────────────────────────────────────────────────────────
# MiniMax Speech 2.8 HD Sync
THOTH_MINIMAX_API_KEY=your_minimax_api_key
THOTH_MINIMAX_GROUP_ID=your_minimax_group_id

# Fish Audio S2 Pro
THOTH_FISH_AUDIO_API_KEY=your_fish_audio_key

# ElevenLabs
THOTH_ELEVENLABS_API_KEY=

# ─── Avatar ───────────────────────────────────────────────────────────────────
THOTH_DID_API_KEY=
THOTH_HEYGEN_API_KEY=

# ─── Tooling / override (opsional) ────────────────────────────────────────────
FFMPEG_PATH=                 # path ffmpeg.exe (kosong = auto-download / ffmpeg.exe lokal)
THOTH_PYTHON=                # interpreter Python untuk renderer cover/headline (kosong = "python")
THOTH_WHISPER_LANGUAGE=      # paksa bahasa transcribe, mis. "id" (kosong = auto-detect)

# ─── Knob model scout (opsional — default sudah bagus, lihat docs/MODELS.md) ─
# Catatan: scout membaca .novita_key (FILE di folder scout/), bukan key di atas.
THOTH_LLM_MODEL=             # task teks scout (footage_objects/extract_figures/resolve_source)
THOTH_CONTEXT_MODEL=         # enrich_context / pulse_harvest (default deepseek-v3.1)
THOTH_VISION_MODEL=          # vision crop/discovery (default qwen3-vl-30b-a3b; 8b deprecated Novita)
THOTH_EMBED_MODEL=           # embedding CKB/RAG (default qwen3-embedding-8b)
THOTH_GROUND=                # "0" = matikan web-grounding status entitas (enrich_context)
# CKB (Cultural Knowledge Base) Supabase: pakai THOTH_SUPABASE_URL di atas + `npm install pg` +
# file scout/.supabase_url. Tanpa itu → CKB degrade ke cache lokal JSON. Lihat scout/README.md.

# ─── Acquisition kernel (scout/acquisition/, opsional — default sudah dipakai kalau kosong) ───
# Semua pipeline/*.ts akuisisi lewat sini (Task 16 boundary). Detail lengkap (fallback order,
# circuit breaker, aturan data sensitif, cara clear cache): scout/README.md bagian 7.
GALLERY_DL=gallery-dl                      # binary gallery-dl; opsional, auto-skip kalau tak ada
YTDLP=yt-dlp                                # binary yt-dlp (juga dipakai chain video/YouTube)
THOTH_ACQUISITION_CAPTURE_MS=15000          # timeout tangkap social-card/screenshot (ms)
THOTH_ACQUISITION_DISCOVERY_TTL_MS=1800000  # cache durable discover() (ms, default 30 menit)
THOTH_ACQUISITION_POST_TTL_MS=21600000      # cache durable inspectPost() (ms, default 6 jam)
THOTH_ACQUISITION_NEGATIVE_TTL_MS=900000    # cache negatif (gagal) (ms, default 15 menit)
