# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Get a free Groq key at: https://console.groq.com
CLIPPER_GROQ_API_KEY=your_groq_api_key_here

# Get an OpenAI key at: https://platform.openai.com/api-keys
CLIPPER_OPENAI_API_KEY=your_openai_api_key_here

# ── Optional overrides ────────────────────────────────────────────────────────
# RUST_LOG=clipper=debug          # verbose logging
# CLIPPER_WHISPER_MODEL_SIZE=large-v3
# CLIPPER_LLM_DEFAULT_PROVIDER=openai
# CLIPPER_FFMPEG_NVENC=false      # disable GPU encoding
