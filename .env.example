# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Get a free Groq key at: https://console.groq.com
CLIPPER_GROQ_API_KEY=your_groq_api_key_here

# Get an OpenAI key at: https://platform.openai.com/api-keys
CLIPPER_OPENAI_API_KEY=your_openai_api_key_here

# Get a Claude key at: https://console.anthropic.com/
CLIPPER_CLAUDE_API_KEY=your_claude_api_key_here

# Get a Gemini key at: https://aistudio.google.com/apikey (free tier available)
CLIPPER_GEMINI_API_KEY=your_gemini_api_key_here

# vLLM — only needed if your vLLM server has authentication enabled
# Most local vLLM deployments do NOT require an API key (leave blank)
CLIPPER_VLLM_API_KEY=

# ── RAG Embedding (Vector DB) ──────────────────────────────────────────────
CLIPPER_SUPABASE_URL=postgresql://user:password@host:5432/dbname

# API key khusus untuk embedding RAG (opsional).
# Gunakan ini jika embed_provider = "openai" dan Anda memakai provider
# OpenAI-compatible (Novita AI, Together AI, dll.) dengan API key terpisah.
# Jika kosong, fallback ke CLIPPER_OPENAI_API_KEY.
CLIPPER_EMBED_API_KEY=your_novita_or_openai_embedding_key_here

# ── Optional overrides ────────────────────────────────────────────────────────
# RUST_LOG=clipper=debug          # verbose logging
# CLIPPER_WHISPER_MODEL_SIZE=large-v3
# CLIPPER_LLM_DEFAULT_PROVIDER=openai
# CLIPPER_FFMPEG_NVENC=false      # disable GPU encoding
