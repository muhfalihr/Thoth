# CLIPPER — Environment Variables Template
# Copy ke .env dan isi nilai yang sesuai.
# JANGAN commit .env ke git — sudah ada di .gitignore

# ─── LLM Providers ───────────────────────────────────────────────────────────
CLIPPER_GROQ_API_KEY=your_groq_key_here
CLIPPER_OPENAI_API_KEY=your_openai_key_here
CLIPPER_CLAUDE_API_KEY=your_anthropic_key_here
CLIPPER_GEMINI_API_KEY=your_gemini_key_here
CLIPPER_NOVITA_API_KEY=your_novita_key_here
CLIPPER_TOGETHER_API_KEY=
CLIPPER_FIREWORKS_API_KEY=
CLIPPER_VLLM_API_KEY=

# ─── Vector DB / RAG ─────────────────────────────────────────────────────────
CLIPPER_SUPABASE_URL=postgresql://user:pass@host:5432/db
CLIPPER_EMBED_API_KEY=

# ─── News Enrichment ─────────────────────────────────────────────────────────
CLIPPER_SERPER_API_KEY=

# ─── TTS Providers ───────────────────────────────────────────────────────────
# MiniMax Speech 2.8 HD Sync
CLIPPER_MINIMAX_API_KEY=your_minimax_api_key
CLIPPER_MINIMAX_GROUP_ID=your_minimax_group_id

# Fish Audio S2 Pro
CLIPPER_FISH_AUDIO_API_KEY=your_fish_audio_key

# ElevenLabs
CLIPPER_ELEVENLABS_API_KEY=

# ─── Avatar ───────────────────────────────────────────────────────────────────
CLIPPER_DID_API_KEY=
CLIPPER_HEYGEN_API_KEY=
