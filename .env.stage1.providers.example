# Shape reference only — this is not a usable provider file.
#
# Copy the two names, not the values, into an absolute path outside this
# repository (for example /home/<operator>/secrets/stage1.providers.env), fill in a
# real key, and `chmod 600` it. Then point the deployment at it:
#
#   export THOTH_STAGE1_PROVIDER_ENV_FILE=/absolute/path/outside/repository/stage1.providers.env
#   uv run --project python thoth-control-plane operations stage1-local-preflight \
#     --env-file .env.stage1.local --provider-env-file "$THOTH_STAGE1_PROVIDER_ENV_FILE"
#
# The preflight rejects a placeholder key, an in-repository path, any third
# variable, and (on Linux) a group- or world-readable mode.
THOTH_NOVITA_API_KEY=replace-with-local-secret
THOTH_SUBTITLE_OCR_MODEL=deepseek/deepseek-ocr
